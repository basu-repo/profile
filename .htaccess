# Security hardening for Apache/cPanel
# RewriteOptions inherit is intentionally EXCLUDED to prevent inheriting malicious rules from parent directories

# Run this site on PHP 8.1. The code does not parse on the host's default PHP
# 7.2. This file replaces the server's copy on every upload, so the handler has
# to live here or the domain silently drops back to 7.2. The handler name is
# specific to the host: if cPanel's MultiPHP Manager or "Select PHP Version"
# writes a different line, use that one instead.
<IfModule mime_module>
  AddHandler application/x-httpd-php81 .php
</IfModule>

DirectoryIndex index.php

# Disable directory listing
Options -Indexes

# Prevent content type sniffing and clickjacking
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Strict CSP for this site's current assets
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; img-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Enable HSTS only when site is served over HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical domain redirect
  RewriteCond %{HTTP_HOST} ^basudeoshrestha\.com\.np$ [OR]
  RewriteCond %{HTTP_HOST} ^www\.basudeoshrestha\.com\.np$
  RewriteCond %{HTTPS} on
  RewriteRule ^ https://basudeoshrestha.com.np%{REQUEST_URI} [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ---------------------------------------------------------------------
  # Application code and data are never served directly. Only index.php,
  # the asset folders (css, js, images, certificates, uploads) and the
  # favicon are reachable from the web.
  # ---------------------------------------------------------------------
  RewriteRule ^(app|bin|config|database|storage|legacy|includes)(/|$) - [F,L]

  # ---------------------------------------------------------------------
  # Addresses this site used before the MVC restructure. They redirect to
  # the routes in app/routes.php so old links and search results survive.
  # ---------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+index\.(php|html)[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /submit-form.php is handled by a route, not a rule here: a redirect would
  # drop the POST body, and an internal rewrite leaves REQUEST_URI unchanged so
  # the router would never see the new path.

  RewriteRule ^admin/index\.php$ /admin [R=301,L]
  RewriteRule ^admin/(dashboard|login|logout|setup|content)\.php$ /admin/$1 [R=301,L]
  RewriteRule ^admin/messages\.php$ /admin/messages [R=301,L,QSA]

  RewriteCond %{QUERY_STRING} (?:^|&)id=([0-9]+)
  RewriteRule ^admin/message\.php$ /admin/messages/%1? [R=301,L]
  RewriteRule ^admin/message\.php$ /admin/messages [R=301,L]

  # ---------------------------------------------------------------------
  # Front controller: anything that is not a real file or directory is a
  # route.
  # ---------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Deny access to sensitive files wherever they appear
<FilesMatch "^(\.env|composer\.(json|lock)|package\.json|package-lock\.json|yarn\.lock|README\.md|mail_debug\.log|contact_messages\.csv|config\.php|.*\.sql)$">
  Require all denied
</FilesMatch>
